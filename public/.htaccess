<IfModule mod_rewrite.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar)$">
        # Block access to PHP files in uploads directory (prevents webshell execution)
        <If "%{REQUEST_URI} =~ m#/uploads/#">
            Require all denied
        </If>
    </FilesMatch>
</IfModule>

# ============================================================
# JAPANESE SEO HACK PREVENTION
# This hack injects Japanese spam pages that appear in Google.
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block requests with Japanese/CJK characters in the URL
    RewriteCond %{QUERY_STRING} [\x{3040}-\x{309F}\x{30A0}-\x{30FF}\x{4E00}-\x{9FFF}] [NC]
    RewriteRule .* - [F,L]

    RewriteCond %{REQUEST_URI} [\x{3040}-\x{309F}\x{30A0}-\x{30FF}\x{4E00}-\x{9FFF}] [NC]
    RewriteRule .* - [F,L]

    # Block common webshell filenames used in Japanese hack campaigns
    RewriteCond %{REQUEST_URI} (shell|c99|r57|b374k|wso|alfa|indoxploit|hackbar|bypass|config\.bak|\.env\.bak) [NC]
    RewriteRule .* - [F,L]

    # Block suspicious user agents commonly used by Japanese hack bots
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|scan|nmap|masscan|zgrab) [NC]
    RewriteRule .* - [F,L]

    # Prevent PHP execution in uploads directory
    RewriteCond %{REQUEST_URI} ^/public/uploads/.*\.php [NC]
    RewriteRule .* - [F,L]

    # Block direct access to sensitive Laravel files
    RewriteRule ^(\.env|composer\.json|composer\.lock|package\.json|artisan) - [F,L]
    RewriteRule ^(storage|bootstrap/cache)/ - [F,L]

    # Standard Laravel rewrite
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ============================================================
# SECURITY HEADERS
# ============================================================

<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# Block access to hidden files (e.g. .git, .env)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to backup and config files
<FilesMatch "\.(bak|backup|old|orig|sql|log|ini|cfg|conf|dist|swp|tmp)$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes

# Limit file upload size (optional, adjust as needed)
LimitRequestBody 20971520
